+    #[test]
+    fn sigma_parse_bytes_lenient_accepts_non_sigmaprop_root() {
+        // The conformance runner needs to evaluate arbitrary-typed root exprs.
+        // Strict parse rejects a non-SigmaProp root on a sized tree (→ Unparsed);
+        // the lenient parse (mirror of sigma-state `deserializeErgoTree(checkType
+        // = false)`) accepts it as a Parsed tree with the root accessible.
+        let expr: Expr = 1i32.into(); // Int root, not SigmaProp
+        let bytes = ErgoTree::new(ErgoTreeHeader::v1(true), &expr)
+            .unwrap()
+            .sigma_serialize_bytes()
+            .unwrap();
+
+        // strict: a sized non-SigmaProp root is not parsed (preserved as Unparsed)
+        let strict = ErgoTree::sigma_parse_bytes(&bytes).unwrap();
+        assert!(
+            strict.parsed_tree().is_err(),
+            "strict parse must not yield a Parsed tree for a non-SigmaProp root"
+        );
+
+        // lenient: Parsed, root accessible and of the original (Int) type
+        let lenient = ErgoTree::sigma_parse_bytes_lenient(&bytes).unwrap();
+        assert!(
+            lenient.parsed_tree().is_ok(),
+            "lenient parse must yield a Parsed tree for a non-SigmaProp root"
+        );
+        assert_eq!(lenient.proposition().unwrap().tpe(), SType::SInt);
+
+        // the flag does not leak: the next strict parse is strict again
+        assert!(ErgoTree::sigma_parse_bytes(&bytes).unwrap().parsed_tree().is_err());
+    }
