#!/usr/bin/env bash
# santa-run <impl-path> <vectors-dir> <out-dir>  — emit actuals for the orchestrator.
#
# SANTA owns the impl checkout (runner-integration contract §2-3): it clones
# runner.json's `impl` (<url>#<ref>) into a per-instance cache and passes the
# containing dir as $1; our dependency is at $1/sigma-rust. Wire our fixed Cargo
# path-dep (../sigma-rust) to that checkout, then build + emit. Using $1 (not a
# shared ../sigma-rust) is what lets two runner dirs pin different refs.
#
# Toolchain self-provisioned (presence-as-state: mise.toml) — re-exec once under
# `mise exec` so cargo is on PATH for the build. The orchestrator stays
# toolchain-agnostic; `mise` on PATH is the one bootstrap dep; santa-run trusts its
# own co-located config. (develop: no cost model — values only.)
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -z "${SANTA_MISE_ACTIVE:-}" ]; then
  mise trust "$here/mise.toml" >/dev/null
  mise --cd "$here" install
  exec env SANTA_MISE_ACTIVE=1 mise --cd "$here" exec -- "$0" "$@"
fi
impl="$(cd "$1" && pwd)"
ln -sfn "$impl/sigma-rust" "$here/../sigma-rust"
cargo build --release --manifest-path "$here/Cargo.toml" >/dev/null
"$here/target/release/blitzen" emit "$2" "$3"
