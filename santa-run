#!/usr/bin/env bash
# santa-run <impl-path> <vectors-dir> <out-dir>  — emit actuals for the orchestrator.
#
# SANTA owns the impl checkout (runner-integration contract §2-3): it clones
# runner.json's `impl` (<url>#<ref>) into a per-instance cache and passes the
# containing dir as $1; our dependency is at $1/sigma-rust. Wire our fixed Cargo
# path-dep (../sigma-rust) to that checkout, then build + emit. Using $1 (not a
# shared ../sigma-rust) is what lets two runner dirs pin different refs.
#
# This is the *eni* runner: sigma-rust here carries the JIT-cost + lazy-constants
# work, so we build with `--features jit-cost` to read real costs. (The develop
# runner omits the flag — upstream has no cost model, so it emits values only.)
#
# Toolchain self-provisioned (presence-as-state: mise.toml) — re-exec once under
# `mise exec` so cargo is on PATH for the build. The orchestrator stays
# toolchain-agnostic; `mise` on PATH is the one bootstrap dep; santa-run trusts its
# own co-located config.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -z "${SANTA_MISE_ACTIVE:-}" ]; then
  mise trust "$here/mise.toml" >/dev/null
  mise --cd "$here" install
  exec env SANTA_MISE_ACTIVE=1 mise --cd "$here" exec -- "$0" "$@"
fi
impl="$(cd "$1" && pwd)"
ln -sfn "$impl/sigma-rust" "$here/../sigma-rust"
# Build-identity patch (runner-contract §3, declared in README + patches/):
# sigma-rust exposes no lenient (non-SigmaProp-root) parse entry, so the build
# applies patches/sigma-rust-lenient-parse.patch to the checkout — additive and
# behavior-neutral (production sigma_parse/sigma_parse_bytes unchanged; adds
# ErgoTree::sigma_parse_bytes_lenient, eval.rs's parse entry). Unlike the retired
# byte-munging lenient_tree_bytes, it parses the REAL header, so size-bit
# semantics (Rule-1012) are preserved. conform's checkout step is a plain
# `git checkout` (no -f), so the tree MUST be pristine again afterwards: heal any
# crashed previous run on entry, apply, and restore via the EXIT trap (the patch
# touches one tracked file, adds none).
restore() { git -C "$impl/sigma-rust" checkout -q -- .; }
restore   # heal a crashed previous run before applying afresh
git -C "$impl/sigma-rust" apply "$here/patches/sigma-rust-lenient-parse.patch"
trap restore EXIT
cargo build --release --features jit-cost --manifest-path "$here/Cargo.toml" >/dev/null
"$here/target/release/blitzen" emit "$2" "$3"
